# OctoMaster Pro - Environment Configuration
# Copy this file to .env and fill in your values

# =================================
# Application Settings
# =================================
APP_NAME=OctoMaster Pro
APP_VERSION=0.1.0-alpha
APP_ENV=development  # development, production, testing
DEBUG=true
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# =================================
# Octo Browser API
# =================================
OCTO_API_URL=https://api.octobrowser.net
OCTO_API_KEY=your_api_key_here
OCTO_LOCAL_API_PORT=58888

# =================================
# AI Configuration
# =================================
# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-opus-20240229

# Local LLM (optional)
USE_LOCAL_LLM=false
LOCAL_LLM_MODEL_PATH=/path/to/model
LOCAL_LLM_API_URL=http://localhost:11434  # Ollama default

# =================================
# Database
# =================================
DATABASE_URL=sqlite:///./octomaster.db
# For PostgreSQL: postgresql://user:password@localhost/octomaster
# For MySQL: mysql://user:password@localhost/octomaster

# =================================
# Browser Settings
# =================================
DEFAULT_BROWSER=chromium  # chromium, firefox, webkit
HEADLESS=false
BROWSER_TIMEOUT=30000  # milliseconds
DOWNLOAD_PATH=./downloads
SCREENSHOT_PATH=./screenshots

# WebEngine Settings (for embedded browser panel)
# Disable these if running in VM and experiencing crashes
QTWEBENGINE_CHROMIUM_FLAGS=--disable-gpu --disable-software-rasterizer --no-sandbox
QT_XCB_GL_INTEGRATION=none
LIBGL_ALWAYS_SOFTWARE=1

# =================================
# Proxy Settings (optional)
# =================================
USE_PROXY=false
PROXY_URL=http://user:pass@proxy.example.com:8080
PROXY_ROTATION=false

# =================================
# CAPTCHA Solving (optional)
# =================================
USE_CAPTCHA_SOLVER=false
CAPTCHA_SERVICE=2captcha  # 2captcha, anticaptcha
CAPTCHA_API_KEY=your_captcha_api_key_here

# =================================
# Cloud Storage (optional)
# =================================
# Google Drive
GDRIVE_ENABLED=false
GDRIVE_CLIENT_ID=your_client_id
GDRIVE_CLIENT_SECRET=your_client_secret

# Dropbox
DROPBOX_ENABLED=false
DROPBOX_ACCESS_TOKEN=your_access_token

# =================================
# Notifications
# =================================
# Email
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@octomaster.pro

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Slack
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Discord
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# =================================
# Scheduler
# =================================
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
MAX_CONCURRENT_JOBS=5

# =================================
# Security
# =================================
SECRET_KEY=your_secret_key_here_change_this_in_production
ENCRYPTION_KEY=your_encryption_key_here_32_characters_long
SESSION_TIMEOUT=3600  # seconds

# =================================
# Performance
# =================================
MAX_WORKERS=4
CACHE_ENABLED=true
CACHE_TTL=3600  # seconds

# =================================
# Features Flags
# =================================
ENABLE_AI_ASSISTANT=true
ENABLE_RECORDER=true
ENABLE_CLOUD_SYNC=false
ENABLE_TEAM_COLLABORATION=false
ENABLE_ANALYTICS=true

# =================================
# API Server (for integrations)
# =================================
API_ENABLED=false
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000"]

# =================================
# Telemetry (optional)
# =================================
TELEMETRY_ENABLED=false
ANALYTICS_ID=your_analytics_id
SENTRY_DSN=your_sentry_dsn
